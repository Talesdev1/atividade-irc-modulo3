# Copie para .env e ajuste para o seu ambiente:
#   cp .env.example .env
# O .env é ignorado pelo Git (ver .gitignore).

# URL da API REST do servidor GNS3
GNS3_SERVER_URL=http://localhost:3080

# Versão da API REST (GNS3 3.x usa /v3; GNS3 2.x usa /v2)
GNS3_API_VERSION=3

# Nome do projeto já importado a partir de base_topology/uasc.gns3project
GNS3_PROJECT_NAME=uasc

# Token JWT lido pelo script e enviado como "Authorization: Bearer <access_token>"
GNS3_ACCESS_TOKEN=

# Host usado pelo Netmiko para alcançar as portas de console exportadas.
# É o endereço do servidor GNS3, não o IP de gerência dos switches.
GNS3_CONSOLE_HOST=127.0.0.1

# Credenciais dos switches EXOS (usadas a partir do Milestone 3)
EXOS_USERNAME=admin
EXOS_PASSWORD=
